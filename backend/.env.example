# DX Store backend — environment template.
#
# Copy to `backend/.env` and fill in. `.env` is gitignored; never commit real
# values. Every key is optional unless marked REQUIRED; the default in
# config.py applies when a key is absent.

# --- Core -------------------------------------------------------------------
# development (debug + auto-reload, run.py) | production (serve.py / Waitress)
FLASK_ENV=development
HOST=0.0.0.0
PORT=5001
WEB_THREADS=8

# REQUIRED in production: a long random string (session signing). The app
# refuses to start in production with the built-in dev default.
SECRET_KEY=change-me-to-a-long-random-string

# SQLite path or a Postgres URL. The live plant DB lives OUTSIDE the repo.
#   sqlite:///C:/dx_store_data/dx_store.db
#   postgresql+psycopg2://user:password@host:5432/dx_store
DATABASE_URL=sqlite:///C:/dx_store_data/dx_store.db

# Comma-separated origins allowed to call /api with credentials (the Vite dev
# server; add the LAN address the plant uses).
CORS_ORIGINS=http://localhost:5173

# Shared key for the ERP machine caller (X-API-Key). REQUIRED in production.
API_KEY=

# Largest upload accepted, in bytes (default 10 MB).
MAX_UPLOAD_BYTES=10485760

# Login throttling, per client IP.
RATE_LIMIT_ENABLED=true
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW=60

# Set to 1 only for `flask db migrate` against an empty database (skips the
# boot-time create_all / schema patch). Leave unset when running the app.
SKIP_DB_INIT=

# --- ERP: stock write-back (issue / receive / return pushed to ERP) ---------
# Stays OFF until the ERP endpoint exists; movements queue until then.
ERP_STOCK_WRITE_ENABLED=false
ERP_API_BASE_URL=
ERP_API_TIMEOUT=10

# --- ERP: ledger file inbox --------------------------------------------------
ERP_LEDGER_INBOX=
ERP_LEDGER_POLL_SECONDS=300

# --- ERP: read-only database sync (gate entries, SRV report mirrors) --------
ERP_DB_HOST=
ERP_DB_PORT=5432
ERP_DB_NAME=toyota_db
ERP_DB_USER=
ERP_DB_PASSWORD=
ERP_DB_SCHEMA=termsdb
ERP_DB_CONNECT_TIMEOUT=8
ERP_SYNC_SINCE_DAYS=120
# 0 = no background poller (sync on demand only).
ERP_SYNC_POLL_SECONDS=0

# --- Mail (window-time report, reorder notices) -----------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=20
MAIL_FROM_DISPLAY=TBDI_store
WINDOW_TIME_MAIL_ENABLED=false
WINDOW_TIME_MAIL_HOUR=7
